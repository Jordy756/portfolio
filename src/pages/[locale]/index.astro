---
import Footer from '@components/chrome/Footer.astro';
import Header from '@components/chrome/Header.astro';
import Marquee from '@components/chrome/Marquee.astro';
import AboutMe from '@components/sections/AboutMe.astro';
import Experience from '@components/sections/Experience.astro';
import HeroImage from '@components/sections/HeroImage.astro';
import Layout from '@layouts/Layout.astro';
import DownloadCV from '@components/sections/DownloadCV.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import ContactMe from '@components/sections/ContactMe.astro';

export const getStaticPaths = async () => [{ params: { locale: 'en' } }, { params: { locale: 'es' } }];

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);

const phrases = [t('marquee.phrase.1'), t('marquee.phrase.2'), t('marquee.phrase.3'), t('marquee.phrase.4')];
const baseClasses = 'px-5 py-3.75 font-semibold text-center text-xl border-neutral-950 flex-1 flex';
---

<Layout title={t('home.title')} description={t('home.description')}>
  <div class:list={['relative layout-grid min-h-screen w-page mx-auto xl:border-x-2 border-neutral-950 max-h-screen']}>
    <Header class="grid-area-header" />
    <aside class="flex flex-col grid-area-aside">
      <AboutMe />
    </aside>
    <main class="flex border-b-2 border-l-2 grid-area-main border-neutral-950">
      <div class="flex flex-1 flex-col">
        <DownloadCV />
        <HeroImage />
      </div>
      <Marquee phrases={phrases} direction="vertical" />
      <div class="flex flex-1 flex-col">
        <ContactMe />
        <Experience />
      </div>
    </main>
    <Footer class="grid-area-footer" />
    <!-- <Header class="grid-area-header" />
    <aside class="flex grid-area-aside border-l-2 border-b-2">
      <nav aria-label={t('nav.aria.main')} class="flex flex-1 writing-mode-sideways-lr uppercase">
        <a href="#projects" class:list={[baseClasses]}>
          {t('nav.projects')}
        </a>
        <a href="#contact" class:list={[baseClasses, 'border-b-2']}>
          {t('nav.contact')}
        </a>
      </nav>
    </aside>
    <Marquee phrases={phrases} direction="vertical" class="grid-area-marquee" />
    <main class="flex flex-col grid-area-main border-neutral-950 border-b-2 overflow-y-scroll">
      <HeroImage />
      <AboutMe />
      <ContactMe />
      <Experience />
    </main>
    <Footer class="grid-area-footer" /> -->
  </div>
</Layout>
