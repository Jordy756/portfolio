---
import Footer from '@components/chrome/Footer.astro';
import Header from '@components/chrome/Header.astro';
import Marquee from '@components/chrome/Marquee.astro';
import AboutMe from '@components/sections/AboutMe.astro';
import Experience from '@components/sections/Experience.astro';
import IdkYet from '@components/sections/IdkYet.astro';
import IdkYet2 from '@components/sections/IdkYet2.astro';
import Layout from '@layouts/Layout.astro';
import SpotifyPlaylist from '@components/sections/SpotifyPlaylist.astro';

const phrases = ['Web Developer', 'Frontend Developer', 'Backend Developer', 'UI/UX Designer'];
---

<Layout title="Home" description="Descripción de la página de inicio">
  <div class="relative grid min-h-screen grid-cols-[1fr_2.25fr] grid-rows-[auto_1fr_auto] overflow-x-clip">
    <Header class="col-start-1 row-start-1" />
    <main class="col-span-2 col-start-2 row-span-2 row-start-1 flex border-b-2 border-l-2">
      <section class="flex flex-1 flex-col">
        <SpotifyPlaylist playlistId="REEMPLAZAR_CON_TU_PLAYLIST_ID" />
        <IdkYet2 />
      </section>
      <Marquee phrases={phrases} direction="vertical" />
      <section class="flex flex-1 flex-col">
        <Experience />
      </section>
    </main>
    <aside class="col-start-1 row-span-2 row-start-2 flex flex-col">
      <AboutMe />
      <IdkYet />
    </aside>
    <Footer class="col-span-2 col-start-2 row-start-3">footer</Footer>
  </div>
</Layout>
