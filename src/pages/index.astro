---
import Footer from '@components/chrome/Footer.astro';
import Header from '@components/chrome/Header.astro';
import Marquee from '@components/chrome/Marquee.astro';
import AboutMe from '@components/sections/AboutMe.astro';
import Experience from '@components/sections/Experience.astro';
import IdkYet from '@components/sections/IdkYet.astro';
import IdkYet2 from '@components/sections/IdkYet2.astro';
import Layout from '@layouts/Layout.astro';
import IdkYet3 from '@components/sections/IdkYet3.astro';

const phrases = ['Web Developer', 'Frontend Developer', 'Backend Developer', 'UI/UX Designer'];
---

<Layout title="Home" description="Descripción de la página de inicio">
  <div class="relative layout-grid grid min-h-screen overflow-x-clip">
    <Header class="grid-area-header" />
    <main class="flex border-b-2 border-l-2 grid-area-main">
      <section class="flex flex-1 flex-col">
        <IdkYet3 />
        <IdkYet2 />
      </section>
      <Marquee phrases={phrases} direction="vertical" />
      <section class="flex flex-1 flex-col">
        <Experience />
      </section>
    </main>
    <aside class="flex flex-col grid-area-aside">
      <AboutMe />
      <!-- <IdkYet /> -->
    </aside>
    <Footer class="grid-area-footer">footer</Footer>
  </div>
</Layout>
