---
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import Layout from '@layouts/Layout.astro';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Layout title={t('notFound.title')} description={t('notFound.description')}>
  <main class="flex min-h-screen items-center justify-center px-6 py-16 text-center">
    <div class="flex flex-col gap-4">
      <h1 class="font-host-grotesk text-6xl font-semibold uppercase">{t('notFound.title')}</h1>
      <p class="font-host-grotesk text-2xl">{t('notFound.description')}</p>
    </div>
  </main>
</Layout>
