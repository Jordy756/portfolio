---
import Link from '@components/ui/Link.astro';
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, getCurrentLocale, locales } from '@i18n/utils';

interface Props {
  class: string;
}

const { class: className } = Astro.props;

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<header class:list={[className, 'flex items-center justify-between border-b-2 uppercase']}>
  <a href="" class="flex flex-[1.5] items-center justify-center px-4 py-2 text-center text-4xl">
    <Image src="/logo.png" width={237} height={60} alt={t('header.logo.alt')} class="h-15 w-auto object-contain" />
  </a>
  <div class="flex flex-1 flex-col text-xl font-semibold">
    <Link href="/" class="border-t-0">{t('nav.projects')}</Link>
    <Link href="" class="border-y-0">{t('nav.contact')}</Link>
  </div>
  <ul class="text-xl">
    {
      locales.map((loc) => {
        const isCurrent = loc === locale;
        const baseClasses = 'px-5 py-1.5 flex-1';

        return (
          <li class="flex font-semibold not-last:border-b-2">
            {isCurrent ? (
              <span class:list={[baseClasses, 'bg-neutral-950 text-neutral-50']} aria-current="page">
                {loc}
              </span>
            ) : (
              <a href={getRelativeLocaleUrl(loc, '')} hreflang={loc} class:list={[baseClasses]}>
                {loc}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</header>
