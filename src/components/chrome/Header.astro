---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, getCurrentLocale, locales } from '@i18n/utils';
import Logo from '@components/ui/Logo.astro';

interface Props {
  class: string;
}

const { class: className } = Astro.props;

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const baseClasses = 'px-5 py-1.5 flex-1 font-semibold text-center text-xl';
---

<header class:list={[className, 'flex items-center justify-between uppercase']}>
  <a href="" class="flex flex-[1.5] items-center justify-center px-4 py-2 text-center text-4xl">
    <Logo />
  </a>
  <div class="flex flex-1 flex-col">
    <a href="/" class:list={[baseClasses, 'border-2 border-t-0']}>{t('nav.projects')}</a>
    <a href="" class:list={[baseClasses, 'border-2 border-y-0']}>{t('nav.contact')}</a>
  </div>
  <ul>
    {
      locales.map((locale) => {
        const isCurrent = locale === currentLocale;

        return (
          <li class="flex not-last:border-b-2">
            {isCurrent ? (
              <span class:list={[baseClasses, 'bg-neutral-950 text-neutral-50']} aria-current="page">
                {locale}
              </span>
            ) : (
              <a href={getRelativeLocaleUrl(locale, '')} hreflang={locale} class:list={[baseClasses]}>
                {locale}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</header>
