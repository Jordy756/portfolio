---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, getCurrentLocale, locales } from '@i18n/utils';
import Logo from '@components/ui/Logo.astro';

interface Props {
  class: string;
}

const { class: className } = Astro.props;

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const baseClasses = 'px-5 py-1.5 font-semibold text-center text-xl border-neutral-950';
---

<header class:list={[className, 'flex items-stretch justify-between uppercase border-b-2 border-neutral-950']}>
  <a
    href={`/${currentLocale}/#root`}
    class="flex flex-[1.5] items-center justify-center px-4 py-2"
    aria-label={t('header.logo.action')}
    title={t('header.logo.action')}
  >
    <Logo class="h-16 w-full fill-neutral-950 object-contain" />
  </a>
  <nav aria-label={t('nav.aria.main')} class="flex flex-1 flex-col">
    <a href="#projects" class:list={[baseClasses, 'border-2 border-t-0 ']}>
      {t('nav.projects')}
    </a>
    <a href="#contact" class:list={[baseClasses, 'border-2 border-y-0']}>
      {t('nav.contact')}
    </a>
  </nav>
  <nav aria-label={t('nav.aria.languages')}>
    <ul>
      {locales.map((locale) => {
        const isCurrent = locale === currentLocale;

        return (
          <li class="flex not-last:border-b-2 border-neutral-950">
            {isCurrent ? (
              <span class:list={[baseClasses, 'bg-neutral-950 text-neutral-50 w-full']} aria-current="page">
                {locale}
              </span>
            ) : (
              <a href={getRelativeLocaleUrl(locale, '')} hreflang={locale} class:list={[baseClasses]}>
                {locale}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </nav>
</header>
