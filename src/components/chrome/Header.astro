---
import Link from '@components/ui/Link.astro';
import { Image } from 'astro:assets';

interface Props {
  class: string;
}

const { class: className } = Astro.props;

const locales = ['en', 'es'];
const currentLocale = 'en';
---

<header class:list={[className, 'flex items-center justify-between border-b-2 uppercase']}>
  <a href="" class="flex-[1.5] flex items-center justify-center px-4 py-2 text-center text-4xl">
    <Image src="/logo.png" width={237} height={60} alt="Prueba" class="h-15 w-auto object-contain" />
  </a>
  <div class="flex flex-1 flex-col text-xl font-semibold">
    <Link href="/" class="border-t-0">Projects</Link>
    <Link href="" class="border-y-0">Contact</Link>
  </div>
  <ul class="text-xl">
    {
      locales.map((locale) => {
        const isCurrent = locale === currentLocale;
        const baseClasses = 'px-5 py-1.5 flex-1';

        return (
          <li class="flex font-semibold not-last:border-b-2">
            {isCurrent ? (
              <span class:list={[baseClasses, 'bg-neutral-950 text-neutral-50']} aria-current="page">
                {locale}
              </span>
            ) : (
              <a href={`/${locale}`} hreflang={locale} class:list={[baseClasses]}>
                {locale}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</header>
