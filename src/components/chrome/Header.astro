---
interface Props {
  class: string;
}

const { class: className } = Astro.props;
---

<header class:list={[className, 'flex items-center justify-between border-b-2 uppercase']}>
  <a href="" class="flex-[1.5] px-4 py-2 text-center text-4xl font-semibold">Mono X7</a>
  <div class="flex flex-1 flex-col">
    <a href="" class="border-x-2 border-b-2 px-4 py-2">Preorder</a>
    <a href="" class="border-x-2 px-4 py-2">Contact</a>
  </div>
  <div class="flex flex-col">
    <a href="" class="border-b-2 border-neutral-950 bg-neutral-950 px-4 py-2 text-neutral-50">en</a>
    <a href="" class="px-4 py-2">es</a>
  </div>
</header>
