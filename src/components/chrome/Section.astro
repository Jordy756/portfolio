---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<article class="relative flex-1 border-t-2">
  <header class="absolute top-0 left-0 border-r-2 border-b-2 bg-neutral-50 px-2">
    <h2 class="text-xl font-semibold uppercase">{title}</h2>
  </header>
  <div
    class:list={[
      className,
      'flex scrollbar-thin flex-col gap-6 overflow-y-auto px-16 py-10 font-host-grotesk text-2xl',
    ]}
  >
    <slot />
  </div>
</article>
