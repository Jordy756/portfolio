---
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedInIcon from '@components/icons/LinkedInIcon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();

const links = [
  { label: 'Home', href: '' },
  { label: 'About', href: '' },
  { label: 'Projects', href: '' },
  { label: 'Contact', href: '' },
];

const socialLinks = [
  { href: '', icon: GithubIcon },
  { href: '', icon: LinkedInIcon },
];
---

<footer class:list={[className, 'flex items-center gap-4 border-l-2 px-8 py-4 text-sm uppercase']}>
  <p>&copy; Jordy. {year}</p>
  <ul class="flex items-center gap-4">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <ul class="ml-auto flex items-center gap-2">
    {
      socialLinks.map(({ href, icon: Icon }) => (
        <li>
          <a href={href}>
            <Icon width={24} height={24} class="size-6 text-neutral-950" />
          </a>
        </li>
      ))
    }
  </ul>
</footer>
