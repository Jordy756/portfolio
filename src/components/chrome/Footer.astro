---
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedInIcon from '@components/icons/LinkedInIcon.astro';
import { useTranslations, getCurrentLanguage } from '@i18n/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();

const language = getCurrentLanguage(Astro.currentLocale);
const t = useTranslations(language);

const links = [
  { label: t('nav.home'), href: '' },
  { label: t('nav.about'), href: '' },
  { label: t('nav.projects'), href: '' },
  { label: t('nav.contact'), href: '' },
];

const socialLinks = [
  { href: 'https://github.com/Jordy756', icon: GithubIcon },
  { href: 'https://linkedin.com/in/yordicastro', icon: LinkedInIcon },
];
---

<footer class:list={[className, 'flex items-center gap-4 border-l-2 px-8 py-4 text-sm uppercase']}>
  <p>{t('footer.copyright').replace('{year}', String(year))}</p>
  <ul class="flex items-center gap-4">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <ul class="ml-auto flex items-center gap-4">
    {
      socialLinks.map(({ href, icon: Icon }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer">
            <Icon width={20} height={20} class="size-5 text-neutral-950" />
          </a>
        </li>
      ))
    }
  </ul>
</footer>
