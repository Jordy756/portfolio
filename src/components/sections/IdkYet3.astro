---
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<article class="relative flex flex-1 flex-col items-center justify-center px-16 py-10 text-center">
  <p class="font-host-grotesk text-4xl">{t('sections.idkYet3.paragraph')}</p>
</article>
