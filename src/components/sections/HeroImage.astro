---
import { Image } from 'astro:assets';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<figure class="flex flex-3 items-center justify-center border-t-2">
  <Image src="/images/knight.webp" width={800} height={800} alt={t('hero.image.alt')} class="size-full object-cover" />
</figure>
