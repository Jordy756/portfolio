---
import { Image } from 'astro:assets';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<figure class="relative flex flex-3 items-center justify-center xl:border-t-2 max-xl:border-b-2 border-neutral-950 max-xl:min-h-[calc(100vh-78px)]">
  <Image
    src="/images/knight.webp"
    width={800}
    height={800}
    alt={t('hero.image.alt')}
    class="absolute bottom-0 w-full max-h-full object-contain"
  />
</figure>
