---
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Section title={t('aboutMe.heading')}>
  <p>{t('aboutMe.paragraph.1')}</p>
  <p>{t('aboutMe.paragraph.2')}</p>
  <p>{t('aboutMe.paragraph.3')}</p>
</Section>
