---
import Section from '@components/chrome/Section.astro';
import { getCurrentLocale, useContent } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const c = useContent(locale);
---

<Section title={c.aboutMe.heading}>
  {c.aboutMe.paragraphs.map((paragraph) => (
    <p>{paragraph}</p>
  ))}
</Section>
