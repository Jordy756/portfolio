---
import { Image } from 'astro:assets';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<article class="relative flex flex-3 p-4">
  <Image
    src="/girl.jpg"
    width={500}
    height={800}
    alt={t('sections.idkYet.image.alt')}
    class="absolute top-0 left-0 size-full object-cover"
  />
</article>
