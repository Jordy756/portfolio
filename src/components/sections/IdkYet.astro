---
import { Image } from 'astro:assets';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<article class="relative flex aspect-video border-t-2 p-4">
  <Image
    src="/work_02.png"
    width={500}
    height={800}
    alt={t('sections.idkYet.image.alt')}
    class="absolute top-0 left-0 size-full"
  />
</article>
