---
import { Image } from 'astro:assets';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);

const skills = [
  'TypeScript',
  'JavaScript',
  'React',
  'Astro',
  'Node.js',
  '.NET',
  'Tailwind',
  'GitHub',
  'SQL',
  'Figma',
  'HTML',
];
---

<article
  class="relative flex flex-3 flex-wrap overflow-hidden p-4 before:absolute before:inset-0 before:z-1 before:size-full before:bg-black/0"
>
  <!-- <Image
    src="/girl.webp"
    width={500}
    height={800}
    alt={t('sections.idkYet.image.alt')}
    class="absolute inset-0 size-full object-cover"
  /> -->
  <div class="absolute inset-0 z-10 flex items-center justify-center">
    <h2 class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-9xl uppercase font-bebas-neue">Skills</h2>
    <svg
      class="w-full max-w-md animate-skill-orbit motion-reduce:animate-none"
      viewBox="0 0 200 200"
      aria-label="Skills"
    >
      <defs>
        <path id="skill-orbit" d="M 100,30 A 70,70 0 1,1 99.9,30" fill="none"></path>
      </defs>
      <text class="fill-neutral-950 font-bebas-neue text-xs font-medium tracking-wider uppercase">
        <textPath href="#skill-orbit" startOffset="0%">
          {skills.map((skill) => `${skill} • `)}
        </textPath>
      </text>
    </svg>
  </div>
</article>
