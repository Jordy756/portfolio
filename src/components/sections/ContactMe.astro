---
import EmailIcon from '@components/icons/EmailIcon.astro';
---

<article class="flex flex-3 flex-col justify-center gap-8 px-16 py-10">
  <header>
    <h2 class="font-host-grotesk text-4xl font-normal">Sign up to our mailing list to get the latest on Mono X7.</h2>
  </header>
  <form action="" class="flex w-[70%] items-center gap-2">
    <input
      type="email"
      class="flex-1 border-b border-neutral-700 text-2xl uppercase outline-0"
      placeholder="Email Address"
      value=""
    />
    <button type="submit">
      <EmailIcon width={24} height={24} class="size-6 text-neutral-700" />
    </button>
  </form>
</article>
