---
import ArrowOutwardIcon from '@components/icons/ArrowOutwardIcon.astro';
---

<article class="relative flex flex-3 flex-col justify-center px-16 py-10">
  <header>
    <h2 class="font-bebas-neue text-9xl font-semibold uppercase">Let's build together.</h2>
  </header>
  <a
    href="mailto:jordycastro1756@gmail.com"
    class="absolute right-0 bottom-0 flex items-center justify-center gap-3 border-t-2 border-l-2 bg-neutral-50 px-5 py-1.5 text-center text-xl font-semibold uppercase"
    target="_blank"
    rel="noopener noreferrer"
