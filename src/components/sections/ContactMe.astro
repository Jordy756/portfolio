---
import ArrowOutwardIcon from '@components/icons/ArrowOutwardIcon.astro';
import { getCurrentLocale, useContent } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const { contactMe } = useContent(currentLocale);
---

<section class="relative flex flex-3 flex-col justify-center p-16 xl:py-10 max-xl:border-t-2 xl:border-b-2 border-neutral-950">
  <header>
    <h2 class="font-bebas-neue 2xl:text-9xl sm:text-9xl text-3xl xl:text-8xl font-semibold uppercase">
      {contactMe.heading}
    </h2>
  </header>
  <a
    href="mailto:jordycastro1756@gmail.com"
    class="absolute right-0 bottom-0 flex items-center justify-center gap-3 border-t-2 border-l-2 border-neutral-950 bg-neutral-50 px-5 py-1.5 text-center text-xl font-semibold uppercase"
    target="_blank"
    rel="noopener noreferrer"
  >
    {contactMe.sendMessage}
    <ArrowOutwardIcon width={12} height={12} class="size-3" />
  </a>
</section>
