---
import Section from '@components/chrome/Section.astro';
import { useTranslations, getCurrentLocale } from '@i18n/utils';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Section title={t('experience.heading')} class="max-h-80">
  <p>{t('experience.paragraph.1')}</p>
  <p>{t('experience.paragraph.2')}</p>
  <p>{t('experience.paragraph.3')}</p>
  <p>{t('experience.paragraph.1')}</p>
  <p>{t('experience.paragraph.2')}</p>
  <p>{t('experience.paragraph.3')}</p>
</Section>
