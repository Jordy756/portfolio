---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'btn-primary' | 'btn-secondary';
}

const { variant = 'btn-primary', class: className, ...props } = Astro.props;
---

<a class:list={[className, variant, 'flex items-center justify-center gap-2 border-2 px-5 py-1.5 font-semibold']} {...props}>
  <slot />
</a>
