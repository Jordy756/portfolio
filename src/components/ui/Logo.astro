---
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import { Image } from 'astro:assets';

const locale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<Image src="/logo.webp" width={237} height={55} alt={t('header.logo.alt')} class="h-14 w-auto object-contain" />
